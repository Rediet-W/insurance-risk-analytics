cat <<EOF > .gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
env/

# IDEs and editors
.vscode/
.idea/

# Data files (Crucial: we don't track raw data in Git)
data/*
!data/.gitkeep
EOF
touch data/.gitkeep

cat <<EOF >> .gitignore

# Allow Git to track DVC metadata files inside data directory
!data/**/.gitignore
!data/**/*.dvc
EOF